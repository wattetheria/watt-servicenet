POSTGRES_USER=servicenet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=watt_servicenet

# Use the postgres service hostname when running through Docker Compose.
SERVICENET_DATABASE_URL=postgres://servicenet:change-me@postgres:5432/watt_servicenet
SERVICENET_DATABASE_SCHEMA=public
SERVICENET_HTTP_ADDR=0.0.0.0:8042
SERVICENET_REQUIRE_PROVIDER_OWNERSHIP_CHALLENGES=1

# Generate with: openssl rand -base64 32
SERVICENET_SECRET_BROKER_KEY=replace-with-a-base64-encoded-32-byte-key
SERVICENET_P2P_ENABLED=0
